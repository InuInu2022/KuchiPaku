<Window
  x:Name="MWindow"
  x:Class="KuchiPaku.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
  xmlns:controls="clr-namespace:Enterwell.Clients.Wpf.Notifications.Controls;assembly=Enterwell.Clients.Wpf.Notifications"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:epoxy="https://github.com/kekyo/Epoxy"
  xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
  xmlns:local="clr-namespace:KuchiPaku.Psd;assembly=KuchiPaku.Psd"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.modernwpf.com/2019"
  xmlns:viewmodels="clr-namespace:KuchiPaku.ViewModels"
  Title="{Binding WindowTitle}"
  Width="850"
  Height="500"
  fw:AcrylicWindow.Enabled="True"
  fw:PointerTracker.Enabled="True"
  ui:WindowHelper.UseModernWindowStyle="True"
  ResizeMode="CanResizeWithGrip"
  mc:Ignorable="d"
  >

  <Window.DataContext>
    <viewmodels:MainWindowViewModel />
  </Window.DataContext>

  <Window.Resources>
    <!--
    <Style TargetType="GroupBox">
      <Setter Property="Padding" Value="10,5" />
    </Style>
    -->
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />
  </Window.Resources>

  <!--
  <epoxy:EventBinder.Events>
    <epoxy:Event EventName="Loaded" Command="{Binding Ready}" />
  </epoxy:EventBinder.Events>
  -->

  <Grid>
    <Border Grid.Column="1" Panel.ZIndex="2">
      <controls:NotificationMessageContainer Manager="{Binding Manager}" />
    </Border>
    <ui:NavigationView
      x:Name="NavView"
      Background="Transparent"
      IsBackButtonVisible="Collapsed"
      IsBackEnabled="False"
      IsPaneOpen="True"
      >
      <!--  LEFT NAVIGATION  -->
      <!--
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Icon="OpenFile" Content="Sample Item 1">
          <epoxy:EventBinder.Events>
            <epoxy:Event EventName="PointerPressed" Command="{Binding OpenYmmp}" />
          </epoxy:EventBinder.Events>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Icon="ContactInfo" Content="Sample Item 2" />
        <ui:NavigationViewItem Icon="List" Content="Sample Item 3" />
        <ui:NavigationViewItem Icon="Save" Content="Sample Item 4" />
      </ui:NavigationView.MenuItems>
      -->

      <ScrollViewer Background="{DynamicResource SystemBaseLowColorBrush}">
        <ui:SimpleStackPanel Width="Auto" Margin="5,0">
          <ui:CommandBar Background="{DynamicResource SystemBaseLowColorBrush}" DefaultLabelPosition="Bottom">
            <ui:AppBarButton
              x:Name="OpenYmmp"
              Command="{Binding OpenYmmp}"
              Icon="OpenFile"
              Label="Open ymmp"
              LabelPosition="Default"
              />

            <ui:AppBarButton
              x:Name="ButtonSave"
              Command="{Binding SaveYmmp}"
              Icon="Save"
              Label="Save ymmp"
              />

            <ui:AppBarElementContainer VerticalAlignment="Center">
              <ui:SimpleStackPanel>
                <ui:ToggleSwitch
                  x:Name="toggleSwitch"
                  Margin="5,0"
                  VerticalAlignment="Center"
                  FontSize="11"
                  IsOn="{Binding IsSaveBackup}"
                  OffContent="上書きする"
                  OnContent="バックアップ保存"
                  />
                <ui:ToggleSwitch
                  x:Name="toggleOpenWithSave"
                  Margin="5,0"
                  VerticalAlignment="Center"
                  FontSize="11"
                  IsOn="{Binding IsOpenWithSave}"
                  OffContent="保存後YMM4で開く"
                  OnContent="保存後YMM4で開く"
                  />
              </ui:SimpleStackPanel>

            </ui:AppBarElementContainer>

          </ui:CommandBar>

          <ui:SimpleStackPanel Orientation="Horizontal">
            <ui:SimpleStackPanel>
              <TextBox
                x:Name="targetYmmpFileName"
                Width="Auto"
                Margin="5"
                ui:ControlHelper.PlaceholderText=".ymmpファイルを選択してください"
                FontSize="12"
                IsReadOnly="True"
                Text="{Binding TargetYmmpFileName}"
                />

              <!--  キャラ口パク設定  -->
              <GroupBox>
                <GroupBox.Header>
                  <ui:SimpleStackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="5" Symbol="ContactInfo" />
                    <TextBlock FontSize="20" Text="キャラ口パク設定" />
                  </ui:SimpleStackPanel>
                </GroupBox.Header>

                <ui:SimpleStackPanel Orientation="Horizontal">
                  <ui:SimpleStackPanel>
                    <ListView
                      x:Name="Character"
                      Width="200"
                      MinHeight="100"
                      Background="{DynamicResource SystemChromeLowColorBrush}"
                      BorderBrush="{DynamicResource SystemBaseMediumLowColorBrush}"
                      ItemsSource="{Binding Characters}"
                      SelectedItem="{Binding SelectedCharaItem}"
                      >
                      <ListView.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal">
                            <ToggleButton
                              Width="20"
                              Height="20"
                              Margin="0"
                              Padding="0"
                              IsChecked="{Binding IsExport}"
                              ToolTip="ボタンを押したキャラは出力されなくなります。"
                              >
                              <TextBlock
                                Margin="0"
                                Padding="0"
                                FontSize="8"
                                Text="✔"
                                Visibility="{Binding IsExport, Converter={StaticResource BoolToVisible}}"
                                />
                            </ToggleButton>
                            <TextBlock
                              Margin="5"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding IsExport}"
                              Text="{Binding Name}"
                              />
                            <TextBlock
                              Margin="5"
                              VerticalAlignment="Bottom"
                              FontSize="8"
                              Foreground="Gray"
                              Text="{Binding TachieTypeText}"
                              />
                          </StackPanel>
                        </DataTemplate>
                      </ListView.ItemTemplate>
                    </ListView>
                    <Separator />

                    <ui:SimpleStackPanel Orientation="Horizontal">
                      <ComboBox
                        x:Name="LipSyncSetting"
                        Margin="5"
                        IsEnabled="False"
                        SelectedIndex="0"
                        >
                        <ComboBoxItem Content="口パク設定1" />
                        <ComboBoxItem Content="口パク設定2" />
                      </ComboBox>
                      <!--
                      <ui:CommandBar DefaultLabelPosition="Right">
                        <ui:AppBarButton
                          Icon="Add"
                          IsEnabled="False"
                          Label="Add"
                          />
                      </ui:CommandBar>
                      -->
                    </ui:SimpleStackPanel>
                  </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
              </GroupBox>
            </ui:SimpleStackPanel>




            <!--  口パク画像設定  -->
            <GroupBox IsEnabled="{Binding SelectedItem.IsExport, ElementName=Character}">
              <GroupBox.Header>
                <ui:SimpleStackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Margin="2" Symbol="Setting" />
                  <TextBlock FontSize="20" Text="{Binding SelectedItem.Name, ElementName=Character}" />
                  <Separator Width="20" />
                  <TextBlock FontSize="20" Text="{Binding SelectedItem.Content, ElementName=LipSyncSetting}" />
                </ui:SimpleStackPanel>
              </GroupBox.Header>

              <ui:SimpleStackPanel Orientation="Horizontal">

                <!--  center  -->
                <ui:SimpleStackPanel Name="centerPanel" Margin="10,0,0,0">
                  <ui:SimpleStackPanel IsEnabled="False" Orientation="Horizontal">
                    <Label Margin="5" Content="口パクルール" />
                    <ComboBox
                      x:Name="LipSyncRule"
                      Width="Auto"
                      SelectedIndex="0"
                      >
                      <ListBoxItem Content="標準（PSDToolKit互換）" ToolTip="PSDToolKit互換" />
                      <ListBoxItem Content="あいうえお口パク2" />
                    </ComboBox>
                  </ui:SimpleStackPanel>

                  <!--  口パクイメージ選択forアニメ立ち絵  -->
                  <ListView
                    x:Name="LipSyncImage"
                    Width="300"
                    MinHeight="200"
                    Background="{DynamicResource SystemChromeLowColorBrush}"
                    BorderBrush="{DynamicResource SystemBaseMediumLowColorBrush}"
                    BorderThickness="1"
                    ItemsSource="{Binding LipSyncImages}"
                    Visibility="{c:Binding !IsShowPsdLayerSelector}"
                    >

                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock
                            MinWidth="50"
                            Margin="5"
                            Text="{Binding Name}"
                            />
                          <ComboBox
                            MinWidth="200"
                            MaxWidth="300"
                            Margin="0"
                            ItemsSource="{Binding ImageList}"
                            SelectedIndex="{Binding SelectedItemIndex}"
                            >
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock
                                    Width="70"
                                    FontSize="10"
                                    Text="{Binding ImageName}"
                                    />
                                  <Image
                                    Width="100"
                                    Height="25"
                                    Source="{Binding ImageSrc}"
                                    />
                                </StackPanel>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>

                  <!--  口パクイメージ選択forPSD立ち絵  -->
                  <ui:SimpleStackPanel Orientation="Horizontal">
                    <ListView
                      x:Name="LipSyncLayers"
                      Width="170"
                      MinHeight="275"
                      Background="{DynamicResource SystemChromeLowColorBrush}"
                      BorderBrush="{DynamicResource SystemBaseMediumLowColorBrush}"
                      BorderThickness="1"
                      ItemsSource="{Binding LipSyncLayers}"
                      SelectedItem="{Binding SelectedLayers}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      Visibility="{c:Binding IsShowPsdLayerSelector}"
                      >

                      <ListView.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock
                              MinWidth="50"
                              Margin="0,5"
                              Text="{Binding Name}"
                              />
                            <Border
                              Width="100"
                              Height="45"
                              BorderBrush="Gray"
                              BorderThickness="1"
                              >
                              <Image
                                Width="100"
                                Height="45"
                                epoxy:Fountain.Well="{Binding ThumbImageWell}"
                                Source="{Binding ImageSrc}"
                                ToolTipService.BetweenShowDelay="0"
                                ToolTipService.InitialShowDelay="0"
                                >
                                <Image.ToolTip>
                                  <ToolTip
                                    HorizontalOffset="20"
                                    Placement="Mouse"
                                    VerticalOffset="20"
                                    >
                                    <Border
                                      Background="{DynamicResource SystemBaseMediumLowColorBrush}"
                                      BorderBrush="Black"
                                      BorderThickness="1"
                                      >
                                      <Viewbox Width="300" Height="150">
                                        <Image Source="{Binding ImageSrc}" Stretch="UniformToFill" />
                                      </Viewbox>
                                    </Border>
                                  </ToolTip>
                                </Image.ToolTip>
                              </Image>
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </ListView.ItemTemplate>
                    </ListView>
                    <!--  preview  -->
                    <Border
                      Name="previewPsd"
                      Width="180"
                      MinHeight="100"
                      MaxHeight="{Binding ActualHeight, ElementName=centerPanel}"
                      BorderBrush="Gray"
                      BorderThickness="1"
                      Visibility="{c:Binding IsShowPsdLayerSelector}"
                      >
                      <Image
                        Width="{Binding ActualWidth, ElementName=previewPsd}"
                        MaxHeight="{Binding ActualHeight, ElementName=centerPanel}"
                        epoxy:Fountain.Well="{Binding ThumbImageWell}"
                        Source="{Binding SelectedLayers.FullImageSrc}"
                        Stretch="Uniform"
                        />
                    </Border>
                  </ui:SimpleStackPanel>

                  <ui:SimpleStackPanel Orientation="Horizontal">
                    <Label Margin="5" Content="オプション" />
                    <ComboBox ItemsSource="{Binding ConsonantOptionList}" SelectedItem="{Binding CurrentConsonantOption}" />
                  </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>

                <!--  right  -->
                <!--  PSDレイヤー選択 for PSD立ち絵  -->
                <TreeView
                  Name="PsdLayerSelector"
                  MinWidth="225"
                  MinHeight="100"
                  MaxHeight="{Binding ActualHeight, ElementName=centerPanel}"
                  Background="{DynamicResource SystemChromeLowColorBrush}"
                  BorderBrush="{DynamicResource SystemBaseMediumLowColorBrush}"
                  BorderThickness="1"
                  ItemsSource="{Binding SelectedLayerTree}"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  Visibility="{c:Binding IsShowPsdLayerSelector}"
                  >
                  <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                      <!--
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Margin" Value="0"/>
                      -->
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                      <Setter Property="IsExpanded" Value="{Binding IsFolderOpened, Mode=TwoWay}"/>
                    </Style>
                  </TreeView.ItemContainerStyle>
                  <TreeView.Resources>
                    <!--  CheckBox / RadioButton の共通テンプレート  -->
                    <DataTemplate x:Key="LayerItemTemplate">
                      <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Margin="3" Background="{DynamicResource SystemBaseMediumLowColorBrush}">
                          <Image
                            Width="36"
                            Height="28"
                            epoxy:Fountain.Well="{Binding ThumbImageWell}"
                            Source="{Binding Image}"
                            Stretch="Uniform"
                            ToolTipService.BetweenShowDelay="0"
                            ToolTipService.InitialShowDelay="0"
                            ToolTipService.ShowOnDisabled="True"
                            Visibility="{c:Binding !IsFolder}"
                            >
                            <Image.ToolTip>
                              <ToolTip
                                HorizontalOffset="20"
                                Placement="Mouse"
                                VerticalOffset="20"
                                >
                                <Border
                                  Background="{DynamicResource SystemBaseMediumLowColorBrush}"
                                  BorderBrush="Black"
                                  BorderThickness="1"
                                  >
                                  <Viewbox Width="200" Height="200">
                                    <Image Source="{Binding Image}" />
                                  </Viewbox>
                                </Border>
                              </ToolTip>
                            </Image.ToolTip>
                          </Image>
                        </Border>
                        <TextBlock
                          Text="📁"
                          TextAlignment="Center"
                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                          Visibility="{c:Binding IsFolder}"
                          />
                        <TextBlock
                          Margin="5,0,5,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                          Text="{Binding Name}" />
                      </StackPanel>
                    </DataTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type viewmodels:SelectedLayerViewModel}" ItemsSource="{Binding Children}">
                      <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="2"
                        >
                        <ToggleButton
                          Name="OverrideLayer"
                          Padding="2,5"
                          VerticalAlignment="Center"
                          Content=" 😀 "
                          FontSize="11"
                          IsChecked="{Binding IsOverrideDefaultVisibility}"
                          Visibility="{c:Binding MainVM.IsPartsOverrideMode}"
                          />
                        <TextBlock
                          FontSize="11"
                          Padding="2,0"
                          VerticalAlignment="Center"
                          Visibility="{c:Binding !MainVM.IsPartsOverrideMode}"
                          Text=" " />

                        <!--  ContentControl で UI を切り替える  -->
                        <ContentControl
                          Content="{Binding}"
                          IsEnabled="{c:Binding '!MainVM.IsPartsOverrideMode
                            || IsOverrideDefaultVisibility'}"
                          VerticalAlignment="Center"
                          Margin="2"
                          >
                          <ContentControl.Style>
                            <Style TargetType="ContentControl">
                              <!--  デフォルトのテンプレート  -->
                              <Setter Property="ContentTemplate">
                                <Setter.Value>
                                  <DataTemplate>
                                    <ui:SimpleStackPanel
                                      Name="NoPSDTool"
                                      VerticalAlignment="Center"
                                      Orientation="Horizontal"
                                      >
                                      <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsVisible}">
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LayerItemTemplate}" />
                                      </CheckBox>
                                    </ui:SimpleStackPanel>
                                  </DataTemplate>
                                </Setter.Value>
                              </Setter>

                              <Style.Triggers>
                                <DataTrigger Binding="{c:Binding 'IsPsdToolMode and IsPsdToolForceDisplay'}" Value="True">
                                  <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                      <DataTemplate>
                                        <ui:SimpleStackPanel
                                          Name="PSDTool"
                                          VerticalAlignment="Center"
                                          Orientation="Horizontal"
                                          >
                                          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LayerItemTemplate}" />
                                        </ui:SimpleStackPanel>
                                      </DataTemplate>
                                    </Setter.Value>
                                  </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{c:Binding 'IsPsdToolMode and !IsPsdToolRadioOption and !IsPsdToolForceDisplay'}" Value="True">
                                  <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                      <DataTemplate>
                                        <ui:SimpleStackPanel
                                          Name="PSDTool"
                                          VerticalAlignment="Center"
                                          Orientation="Horizontal"
                                          >
                                          <CheckBox
                                            IsChecked="{Binding IsVisible}"
                                            VerticalAlignment="Center"
                                            Visibility="{c:Binding ' !IsPsdToolRadioOption and !IsPsdToolForceDisplay'}">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LayerItemTemplate}" />
                                          </CheckBox>
                                        </ui:SimpleStackPanel>
                                      </DataTemplate>
                                    </Setter.Value>
                                  </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{c:Binding 'IsPsdToolMode and IsPsdToolRadioOption'}" Value="True">
                                  <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                      <DataTemplate>
                                        <ui:SimpleStackPanel
                                          Name="PSDTool"
                                          VerticalAlignment="Center"
                                          Orientation="Horizontal"
                                          >
                                          <RadioButton
                                            GroupName="{Binding ParentName}"
                                            IsChecked="{Binding IsVisible}"
                                            VerticalAlignment="Center"
                                            Visibility="{c:Binding 'IsPsdToolRadioOption'}"
                                            >
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LayerItemTemplate}" />
                                          </RadioButton>
                                        </ui:SimpleStackPanel>
                                      </DataTemplate>
                                    </Setter.Value>
                                  </Setter>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ContentControl.Style>
                        </ContentControl>
                      </StackPanel>
                    </HierarchicalDataTemplate>
                  </TreeView.Resources>
                </TreeView>

              </ui:SimpleStackPanel>


            </GroupBox>
          </ui:SimpleStackPanel>

          <!--
          <GroupBox Header="挿入レイヤー設定">
            <ui:SimpleStackPanel></ui:SimpleStackPanel>
          </GroupBox>
          -->
          <GroupBox Header="オプション">
            <ui:SimpleStackPanel>
              <ui:SimpleStackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <ui:ToggleSwitch
                  x:Name="togglePsdToolMode"
                  Header="PSDTool独自拡張 (*,!)"
                  Margin="5,0"
                  FontSize="11"
                  IsOn="{Binding IsPsdToolMode}"
                  />
                <ui:ToggleSwitch
                  x:Name="togglePartsOverrideMode"
                  Header="差分上書きモード"
                  Margin="5,0"
                  FontSize="11"
                  IsOn="{Binding IsPartsOverrideMode}"
                  />
              </ui:SimpleStackPanel>
              <ui:SimpleStackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <CheckBox
                  x:Name="MyCheckBox"
                  Margin="3"
                  Content="口パク先行させる"
                  IsChecked="{Binding IsEnabledVisualLead, Mode=TwoWay}"
                  />
                <ui:NumberBox
                  Header="映像先行 msec (66～100):"
                  IsEnabled="{Binding ElementName=MyCheckBox, Path=IsChecked}"
                  Maximum="200"
                  Minimum="0"
                  Value="{Binding VisualLeadMs}"
                  />
              </ui:SimpleStackPanel>
              <Expander
                x:Name="otherOptions"
                Margin="10,0,0,0"
                VerticalAlignment="Top"
                ExpandDirection="Down"
                Header="そのほか"
                IsExpanded="False"
                >
                <WrapPanel fw:PointerTracker.Enabled="True">
                  <Button
                    x:Name="openLicense"
                    Margin="10"
                    Padding="5"
                    Command="{Binding OpenLicenses}"
                    Content="ライセンス"
                    Style="{StaticResource ButtonRevealStyle}"
                    />
                  <Button
                    x:Name="openWebsite"
                    Margin="10"
                    Padding="5"
                    Command="{Binding OpenWebsite}"
                    Content="KuchiPaku公式サイト"
                    Style="{StaticResource ButtonRevealStyle}"
                    />
                  <Button
                    x:Name="openYMM4Website"
                    Margin="10"
                    Padding="5"
                    Command="{Binding OpenYMM4Website}"
                    Content="YMM4公式サイト"
                    Style="{StaticResource ButtonRevealStyle}"
                    />
                </WrapPanel>
              </Expander>
            </ui:SimpleStackPanel>
          </GroupBox>
        </ui:SimpleStackPanel>
      </ScrollViewer>



    </ui:NavigationView>

  </Grid>


